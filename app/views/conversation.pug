extends layout

block content
  .container-fluid.py-5.mt-5
    .row
      // Sidebar with conversation list
      .col-md-4.col-lg-3
        .card.shadow-sm.border-0.mb-4
          .card-header.bg-success.text-white.py-3
            h5.mb-0
              i.fas.fa-comments.me-2
              | Messages
          .card-body.p-0
            a.btn.btn-outline-secondary.btn-sm.d-block.m-3(href="/messages")
              i.fas.fa-arrow-left.me-2
              | Back to All Messages
          
          .list-group.list-group-flush
            // User info card for the conversation partner
            .list-group-item.border-0
              .d-flex.align-items-center.mb-3
                if otherUser.avatar
                  img.rounded-circle.me-3(src=otherUser.avatar, alt=otherUser.name, width="50", height="50")
                else
                  .avatar-placeholder.rounded-circle.bg-secondary.text-white.d-flex.align-items-center.justify-content-center.me-3(style="width: 50px; height: 50px;")
                    i.fas.fa-user
                .user-info
                  h5.mb-0= otherUser.name
                  small.text-muted
                    i.fas.fa-map-marker-alt.me-1
                    | #{otherUser.location || 'London, UK'}
              
              // User stats
              .user-stats.mt-3
                .row.g-2
                  .col-6
                    .stat-item.border.rounded.p-2.text-center
                      .stat-value.text-success.fw-bold #{otherUser.stats ? otherUser.stats.averageRating : '4.8'}
                      .stat-label.small Rating
                  .col-6
                    .stat-item.border.rounded.p-2.text-center
                      .stat-value.text-success.fw-bold #{otherUser.stats ? otherUser.stats.successfulCompletions : '12'}
                      .stat-label.small Exchanges
                
                .mt-3
                  a.btn.btn-outline-success.btn-sm.w-100(href=`/profile/${otherUser.id}`)
                    i.fas.fa-user.me-2
                    | View Profile
            
            // Shared food items
            .list-group-item.border-top
              h6.mb-3 Shared Food Items
              if otherUser.sharedItems && otherUser.sharedItems.length > 0
                each item in otherUser.sharedItems.slice(0, 3)
                  .shared-item.mb-2
                    .d-flex.align-items-center
                      .food-icon.bg-light.rounded.p-2.me-2
                        i.fas.fa-carrot.text-success
                      .item-details
                        .item-name= item.name
                        small.text-muted= item.date
              else
                p.text-muted.small.mb-0 No shared items yet
      
      // Main content area - Messages
      .col-md-8.col-lg-9
        .card.shadow-sm.border-0.h-100
          .card-header.bg-light.py-3.d-flex.justify-content-between.align-items-center
            h5.mb-0
              | Conversation with 
              span.text-success= otherUser.name
            .conversation-actions
              button.btn.btn-outline-secondary.btn-sm.me-2(type="button")
                i.fas.fa-phone.me-1
                | Call
              button.btn.btn-outline-secondary.btn-sm(type="button", data-bs-toggle="modal", data-bs-target="#reportModal")
                i.fas.fa-flag.me-1
                | Report
          
          // Messages container
          .card-body.p-0
            .messages-container(style="height: 60vh; overflow-y: auto;")
              .p-3
                if messages && messages.length > 0
                  each message in messages
                    .message.mb-3(class=message.senderId === user.id ? 'message-outgoing' : 'message-incoming')
                      if message.senderId !== user.id
                        .d-flex
                          if otherUser.avatar
                            img.rounded-circle.me-2(src=otherUser.avatar, alt=otherUser.name, width="32", height="32")
                          else
                            .avatar-placeholder.rounded-circle.bg-secondary.text-white.d-flex.align-items-center.justify-content-center.me-2(style="width: 32px; height: 32px;")
                              i.fas.fa-user.fa-sm
                          .message-bubble.bg-light.rounded.p-3
                            .message-content= message.content
                            .message-meta.d-flex.justify-content-between.align-items-center.mt-1
                              small.text-muted= new Date(message.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})
                              if message.status === 'read'
                                small.text-muted
                                  i.fas.fa-check-double.text-success.ms-1
                      else
                        .d-flex.justify-content-end
                          .message-bubble.bg-success.text-white.rounded.p-3
                            .message-content= message.content
                            .message-meta.d-flex.justify-content-between.align-items-center.mt-1
                              small.text-white-50= new Date(message.timestamp).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})
                              if message.status === 'read'
                                small.text-white-50
                                  i.fas.fa-check-double.ms-1
                              else if message.status === 'delivered'
                                small.text-white-50
                                  i.fas.fa-check.ms-1
                              else
                                small.text-white-50
                                  i.fas.fa-clock.ms-1
                else
                  .text-center.py-5
                    i.fas.fa-comments.text-muted.fa-3x.mb-3
                    p.mb-0 No messages yet
                    small.text-muted Start the conversation!
          
          // Message input
          .card-footer.bg-white.p-3
            form#messageForm
              .input-group
                button.btn.btn-outline-secondary(type="button")
                  i.fas.fa-paperclip
                input.form-control(type="text", placeholder="Type your message...", required)
                button.btn.btn-success(type="submit")
                  i.fas.fa-paper-plane

  // Report User Modal
  #reportModal.modal.fade(tabindex="-1", aria-labelledby="reportModalLabel", aria-hidden="true")
    .modal-dialog
      .modal-content
        .modal-header.bg-danger.text-white
          h5#reportModalLabel.modal-title
            i.fas.fa-flag.me-2
            | Report User
          button.btn-close.btn-close-white(type="button", data-bs-dismiss="modal", aria-label="Close")
        .modal-body
          form#reportForm
            .mb-3
              label.form-label(for="reportReason") Reason for Report
              select#reportReason.form-select(required)
                option(value="", selected, disabled) Select a reason
                option(value="inappropriate") Inappropriate behavior
                option(value="no-show") Did not show up for pickup
                option(value="misrepresentation") Food item misrepresented
                option(value="harassment") Harassment
                option(value="other") Other
            
            .mb-3
              label.form-label(for="reportDetails") Details
              textarea#reportDetails.form-control(rows="4", required, placeholder="Please provide details about your report...")
        
        .modal-footer
          button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Cancel
          button.btn.btn-danger(type="submit", form="reportForm")
            i.fas.fa-paper-plane.me-2
            | Submit Report

block styles
  style.
    .message-bubble {
      max-width: 80%;
      word-wrap: break-word;
    }
    
    .message-outgoing .message-bubble {
      border-top-right-radius: 0 !important;
    }
    
    .message-incoming .message-bubble {
      border-top-left-radius: 0 !important;
    }
    
    .messages-container {
      background-color: #f9f9f9;
      background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23e5e5e5' fill-opacity='0.2' fill-rule='evenodd'/%3E%3C/svg%3E");
    }

block scripts
  script.
    // Scroll to bottom of messages container on load
    document.addEventListener('DOMContentLoaded', function() {
      const messagesContainer = document.querySelector('.messages-container');
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    });
    
    // Handle message form submission
    document.getElementById('messageForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const messageInput = this.querySelector('input');
      const content = messageInput.value.trim();
      
      if (!content) return;
      
      try {
        // In a real implementation, you would send this to the server
        const response = await fetch(`/messages/${conversation.id}/send`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ content })
        });
        
        const result = await response.json();
        
        if (result.success) {
          // Add message to UI
          const messagesContainer = document.querySelector('.messages-container');
          const messageDiv = document.createElement('div');
          messageDiv.className = 'message mb-3 message-outgoing';
          
          const currentTime = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
          
          messageDiv.innerHTML = `
            <div class="d-flex justify-content-end">
              <div class="message-bubble bg-success text-white rounded p-3">
                <div class="message-content">${content}</div>
                <div class="message-meta d-flex justify-content-between align-items-center mt-1">
                  <small class="text-white-50">${currentTime}</small>
                  <small class="text-white-50">
                    <i class="fas fa-clock ms-1"></i>
                  </small>
                </div>
              </div>
            </div>
          `;
          
          messagesContainer.appendChild(messageDiv);
          messagesContainer.scrollTop = messagesContainer.scrollHeight;
          
          // Clear input
          messageInput.value = '';
        } else {
          console.error('Error sending message:', result.error);
          alert('Failed to send message. Please try again.');
        }
      } catch (error) {
        console.error('Error sending message:', error);
        alert('Failed to send message. Please try again.');
      }
    });
    
    // Handle report form submission
    document.getElementById('reportForm').addEventListener('submit', function(e) {
      e.preventDefault();
      
      const reason = document.getElementById('reportReason').value;
      const details = document.getElementById('reportDetails').value;
      
      if (!reason || !details) {
        alert('Please fill in all required fields');
        return;
      }
      
      // In a real implementation, you would send this to the server
      alert('Report submitted successfully. Our team will review it shortly.');
      
      // Close modal
      const modal = bootstrap.Modal.getInstance(document.getElementById('reportModal'));
      modal.hide();
      
      // Clear form
      this.reset();
    });
