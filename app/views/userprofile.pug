extends layout

block content
  // Navigation Bar
  nav.navbar.navbar-expand-lg.navbar-dark.bg-success.fixed-top
    .container
      a.navbar-brand(href='/')
        i.fas.fa-seedling.me-2
        | Minimise Food Waste
      button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNav')
        span.navbar-toggler-icon
      #navbarNav.collapse.navbar-collapse
        ul.navbar-nav.ms-auto
          li.nav-item
            a.nav-link(href='/listing') Browse Food
          li.nav-item
            a.nav-link(href='/recommendations') Recommendations
          li.nav-item
            a.nav-link(href='/messages') Messages
          li.nav-item
            a.nav-link(href='/userlist') Community
          li.nav-item
            a.nav-link(href='/about') About Us
          if user
            li.nav-item
              a.nav-link.active(href='/userprofile') My Profile
            li.nav-item
              a.nav-link.btn.btn-outline-light.ms-2(href='/logout') Logout
          else
            li.nav-item
              a.nav-link.btn.btn-outline-light.ms-2(href='/login') Login
            li.nav-item
              a.nav-link.btn.btn-light.text-success.ms-2(href='/signup') Sign Up

  // Breadcrumb Navigation
  .container.mt-5.pt-5
    nav(aria-label='breadcrumb')
      ol.breadcrumb
        li.breadcrumb-item
          a(href='/') Home
        li.breadcrumb-item
          a(href='/userlist') Community
        li.breadcrumb-item.active(aria-current='page') User Profile

  if user
    // User Profile Header
    .container.py-4
      .card.border-0.shadow-sm.mb-4
        .card-body
          .row.align-items-center
            .col-md-3.text-center.mb-4.mb-md-0
              img.rounded-circle.shadow.img-fluid(src=user.profilePicture || 'https://randomuser.me/api/portraits/men/1.jpg' alt=user.name width='180' height='180')
              .mt-3
                if user.id
                  button.btn.btn-sm.btn-outline-secondary
                    i.fas.fa-camera.me-1
                    | Change Photo
            .col-md-9
              .d-flex.justify-content-between.align-items-start.mb-3
                div
                  h1.mb-0= user.name || 'User Name'
                  p.text-muted
                    i.fas.fa-map-marker-alt.me-1
                    | #{user.location || 'Location not specified'}
                if user.id
                  button.btn.btn-outline-success
                    i.fas.fa-edit.me-1
                    | Edit Profile
              
              // User level and points
              .d-flex.align-items-center.mb-3
                .badge.bg-success.me-2 Level #{user.level ? user.level.level : 1}
                h5.mb-0.me-3 #{user.level ? user.level.name : 'Beginner'}
                .points-badge.bg-light.rounded-pill.px-3.py-1.border.d-flex.align-items-center
                  i.fas.fa-star.text-warning.me-2
                  span.fw-bold #{user.points || 0} points
              
              // Progress to next level
              if user.level && user.level.nextLevel
                .progress.mb-2(style='height: 8px;')
                  .progress-bar.bg-success(role='progressbar' style=`width: ${user.level.progressPercentage}%` aria-valuenow=user.level.progressPercentage aria-valuemin='0' aria-valuemax='100')
                .d-flex.justify-content-between.small.text-muted.mb-3
                  span #{user.level.pointsToNextLevel} points to #{user.level.nextLevel.name}
                  span #{user.level.progressPercentage}%
              
              .row.mb-3
                .col-md-6
                  p
                    i.fas.fa-envelope.me-2.text-muted
                    | #{user.email || 'Email not specified'}
                .col-md-6
                  p
                    i.fas.fa-calendar-alt.me-2.text-muted
                    | Member since #{user.joinDate || 'Not specified'}
              
              // Trust score
              if user.trustScore
                .d-flex.align-items-center
                  .trust-score-badge.bg-light.rounded-pill.px-3.py-1.border.d-flex.align-items-center.me-3
                    i.fas.fa-shield-alt.text-success.me-2
                    span.fw-bold Trust Score: #{user.trustScore.score}/100
                  
                  if user.emailVerified
                    span.badge.bg-info.me-2
                      i.fas.fa-envelope-open.me-1
                      | Email Verified
                  
                  if user.phoneVerified
                    span.badge.bg-info
                      i.fas.fa-mobile-alt.me-1
                      | Phone Verified

    // User Stats
    .container.mb-4
      .card.border-0.shadow-sm
        .card-body.bg-light
          .row.text-center
            .col-md-3.mb-3.mb-md-0
              .h2.fw-bold.text-success #{user.stats ? user.stats.itemsShared : 0}
              p.text-muted.mb-0 Items Shared
            .col-md-3.mb-3.mb-md-0
              .h2.fw-bold.text-success #{user.stats ? user.stats.itemsReceived : 0}
              p.text-muted.mb-0 Items Received
            .col-md-3.mb-3.mb-md-0
              .h2.fw-bold.text-success #{user.stats ? user.stats.averageRating : 0}
              p.text-muted.mb-0 
                i.fas.fa-star.text-warning.me-1
                | Rating (#{user.stats ? user.stats.totalRatings : 0})
            .col-md-3
              .h2.fw-bold.text-success #{user.stats ? user.stats.wastePreventedKg : 0}kg
              p.text-muted.mb-0 Waste Prevented

    // Main Content
    .container.mb-5
      .row
        // Left Column - User Activity
        .col-lg-8
          // Tabs Navigation
          ul.nav.nav-tabs.mb-4(role='tablist')
            li.nav-item(role='presentation')
              button.nav-link.active#shared-tab(data-bs-toggle='tab' data-bs-target='#shared' type='button' role='tab') Items Shared
            li.nav-item(role='presentation')
              button.nav-link#received-tab(data-bs-toggle='tab' data-bs-target='#received' type='button' role='tab') Items Received
            li.nav-item(role='presentation')
              button.nav-link#saved-tab(data-bs-toggle='tab' data-bs-target='#saved' type='button' role='tab') Saved Items
            li.nav-item(role='presentation')
              button.nav-link#activity-tab(data-bs-toggle='tab' data-bs-target='#activity' type='button' role='tab') Activity
          
          // Tab Content
          .tab-content
            // Shared Items Tab
            #shared.tab-pane.fade.show.active(role='tabpanel')
              h3.h5.mb-3 Items You've Shared
              if user.id
                .row.g-4
                  each item in user.sharedItems || []
                    .col-md-6.col-lg-4
                      .card.h-100.border-0.shadow-sm
                        .card-body
                          h5.card-title= item.name
                          p.card-text.small.text-muted Added on #{item.date}
                          .badge.mb-3(class=item.status === 'Available' ? 'bg-success' : (item.status === 'Collected' ? 'bg-primary' : 'bg-secondary'))= item.status
                          .d-flex.justify-content-between.align-items-center.mt-3
                            if item.status === 'Available'
                              a.btn.btn-sm.btn-outline-success(href='#') Edit
                            else if item.status === 'Collected'
                              a.btn.btn-sm.btn-outline-primary(href='#') Details
                            else
                              a.btn.btn-sm.btn-outline-secondary(href='#') Remove
                
                .text-center.mt-4
                  a.btn.btn-success(href='/tag')
                    i.fas.fa-plus.me-2
                    | Share New Item
              else
                .alert.alert-info No items shared yet.
            
            // Received Items Tab
            #received.tab-pane.fade(role='tabpanel')
              h3.h5.mb-3 Items You've Received
              if user.id
                .row.g-4
                  each item in user.receivedItems || []
                    .col-md-6
                      .card.h-100.border-0.shadow-sm
                        .card-body
                          h5.card-title= item.name
                          p.card-text.small.text-muted Received on #{item.date}
                          p.small.mb-3
                            | From: 
                            a(href='#')= item.from
                          .badge.mb-3(class=item.status === 'Received' ? 'bg-success' : 'bg-primary')= item.status
                          .d-flex.justify-content-between.align-items-center.mt-3
                            if item.status === 'Received'
                              a.btn.btn-sm.btn-outline-success(href='#') Mark as Consumed
                            else
                              a.btn.btn-sm.btn-outline-secondary(href='#') Details
              else
                .alert.alert-info No items received yet.
            
            // Saved Items Tab
            #saved.tab-pane.fade(role='tabpanel')
              h3.h5.mb-3 Saved Items
              if user.id
                .row.g-4
                  each item in user.savedItems || []
                    .col-md-6
                      .card.h-100.border-0.shadow-sm
                        .card-body
                          h5.card-title= item.name
                          p.card-text.small.text-muted Available until #{item.date}
                          .d-flex.align-items-center.mb-3
                            i.fas.fa-map-marker-alt.text-success.me-2
                            span.small #{item.distance} km away
                          .d-flex.justify-content-between.align-items-center.mt-3
                            a.btn.btn-sm.btn-outline-danger(href='#')
                              i.fas.fa-heart-broken.me-1
                              | Unsave
                            a.btn.btn-sm.btn-outline-success(href='#') Request
              else
                .alert.alert-info No saved items yet.
            
            // Activity Tab
            #activity.tab-pane.fade(role='tabpanel')
              h3.h5.mb-3 Recent Activity
              ul.list-group.list-group-flush
                if user.recentActivity && user.recentActivity.length > 0
                  each activity in user.recentActivity
                    li.list-group-item.px-0
                      .d-flex.align-items-center
                        .activity-icon.me-3.bg-success.text-white.p-2.rounded-circle
                          if activity.type === 'share'
                            i.fas.fa-share-alt
                          else if activity.type === 'receive'
                            i.fas.fa-hand-holding
                          else if activity.type === 'rating'
                            i.fas.fa-star
                        div
                          if activity.type === 'share'
                            p.mb-0 You shared #{activity.item}
                          else if activity.type === 'receive'
                            p.mb-0 You received #{activity.item}
                          else if activity.type === 'rating'
                            p.mb-0 You received a #{activity.value}-star rating from #{activity.from}
                          small.text-muted #{activity.date}
                else
                  li.list-group-item.px-0.text-center.py-4
                    i.fas.fa-history.text-muted.fa-2x.mb-3
                    p.mb-0 No recent activity
        
        // Right Column - Sidebar
        .col-lg-4
          // User Impact
          .card.border-0.shadow-sm.mb-4
            .card-header.bg-success.text-white
              h3.h5.mb-0 Your Impact
            .card-body
              .impact-stat.mb-3
                h4.h6 Food Waste Prevented
                .progress.mb-2(style='height: 10px')
                  .progress-bar.bg-success(role='progressbar' style=`width: ${user.impact && user.impact.foodWaste ? (user.impact.foodWaste.current / user.impact.foodWaste.goal * 100) : 0}%` aria-valuenow=(user.impact && user.impact.foodWaste ? (user.impact.foodWaste.current / user.impact.foodWaste.goal * 100) : 0) aria-valuemin='0' aria-valuemax='100')
                .d-flex.justify-content-between
                  small.text-muted #{user.impact && user.impact.foodWaste ? user.impact.foodWaste.current : 0}kg
                  small.text-muted Goal: #{user.impact && user.impact.foodWaste ? user.impact.foodWaste.goal : 0}kg
              
              .impact-stat.mb-3
                h4.h6 Carbon Emissions Saved
                .progress.mb-2(style='height: 10px')
                  .progress-bar.bg-info(role='progressbar' style=`width: ${user.impact && user.impact.carbonEmissions ? (user.impact.carbonEmissions.current / user.impact.carbonEmissions.goal * 100) : 0}%` aria-valuenow=(user.impact && user.impact.carbonEmissions ? (user.impact.carbonEmissions.current / user.impact.carbonEmissions.goal * 100) : 0) aria-valuemin='0' aria-valuemax='100')
                .d-flex.justify-content-between
                  small.text-muted #{user.impact && user.impact.carbonEmissions ? user.impact.carbonEmissions.current : 0}kg CO₂
                  small.text-muted Goal: #{user.impact && user.impact.carbonEmissions ? user.impact.carbonEmissions.goal : 0}kg CO₂
              
              .impact-stat
                h4.h6 Community Contribution
                .progress.mb-2(style='height: 10px')
                  .progress-bar.bg-warning(role='progressbar' style=`width: ${user.impact && user.impact.communityContribution ? user.impact.communityContribution.progress : 0}%` aria-valuenow=(user.impact && user.impact.communityContribution ? user.impact.communityContribution.progress : 0) aria-valuemin='0' aria-valuemax='100')
                .d-flex.justify-content-between
                  small.text-muted Level: #{user.impact && user.impact.communityContribution ? user.impact.communityContribution.level : 'Beginner'}
                  small.text-muted Next: #{user.impact && user.impact.communityContribution ? user.impact.communityContribution.next : 'Enthusiast'}
          
          // Badges
          .card.border-0.shadow-sm.mb-4
            .card-header.bg-light
              h3.h5.mb-0 Your Badges
            .card-body
              .row.text-center.g-3
                if user.badges && user.badges.length > 0
                  each badge in user.badges
                    .col-4
                      .badge-icon.bg-light.p-3.rounded-circle.mx-auto.mb-2
                        i(class=`fas fa-${badge.icon || 'award'} text-${badge.color || 'success'} fa-2x`)
                      p.small.mb-0= badge.name
                else
                  // Default badges if none are earned yet
                  .col-4
                    .badge-icon.bg-light.p-3.rounded-circle.mx-auto.mb-2
                      i.fas.fa-seedling.text-success.fa-2x
                    p.small.mb-0 Early Adopter
                  .col-4
                    .badge-icon.bg-light.p-3.rounded-circle.mx-auto.mb-2
                      i.fas.fa-award.text-warning.fa-2x
                    p.small.mb-0 Top Sharer
                  .col-4
                    .badge-icon.bg-light.p-3.rounded-circle.mx-auto.mb-2
                      i.fas.fa-star.text-info.fa-2x
                    p.small.mb-0 5-Star Rating
                  .col-4
                    .badge-icon.bg-light.p-3.rounded-circle.mx-auto.mb-2
                      i.fas.fa-apple-alt.text-danger.fa-2x
                    p.small.mb-0 Fruit Master
                  .col-4
                    .badge-icon.bg-light.p-3.rounded-circle.mx-auto.mb-2
                      i.fas.fa-users.text-primary.fa-2x
                    p.small.mb-0 Community Builder
                  .col-4
                    .badge-icon.bg-light.p-3.rounded-circle.mx-auto.mb-2
                      i.fas.fa-leaf.text-success.fa-2x
                    p.small.mb-0 Eco Warrior
          
          // Upcoming Events
          .card.border-0.shadow-sm
            .card-header.bg-light
              h3.h5.mb-0 Upcoming Events
            .card-body
              if user.upcomingEvents && user.upcomingEvents.length > 0
                each event in user.upcomingEvents
                  .upcoming-event.mb-3
                    h4.h6= event.name
                    p.small.mb-1
                      i.fas.fa-calendar-alt.me-1.text-muted
                      | #{event.date}
                    p.small.mb-2
                      i.fas.fa-map-marker-alt.me-1.text-muted
                      | #{event.location}
                    if event.status === 'Registered'
                      .badge.bg-success.mb-0 Registered
                    else if event.status === 'Interested'
                      button.btn.btn-sm.btn-outline-success I'm Interested
                    else
                      button.btn.btn-sm.btn-outline-success Register
              else
                .text-center.py-4
                  i.fas.fa-calendar.text-muted.fa-2x.mb-3
                  p.mb-0 No upcoming events
                  small.text-muted Check back soon for community events!
  else
    // User Not Found
    .container.py-5.my-5.text-center
      i.fas.fa-user-slash.fa-4x.text-muted.mb-3
      h2.mb-3 User Not Found
      p The user profile you're looking for doesn't exist or you don't have permission to view it.
      a.btn.btn-success.mt-3(href='/userlist') Browse Community Members

block scripts
  script.
    // Initialize tooltips
    document.addEventListener('DOMContentLoaded', function() {
      var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
      var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
      });
    });
