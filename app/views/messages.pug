extends layout

block content
  .container-fluid.py-5.mt-5
    .row
      // Sidebar with conversation list
      .col-md-4.col-lg-3
        .card.shadow-sm.border-0.mb-4
          .card-header.bg-success.text-white.py-3
            h5.mb-0
              i.fas.fa-comments.me-2
              | Messages
          .list-group.list-group-flush
            if conversations && conversations.length > 0
              each conversation in conversations
                a.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center(
                  href=`/messages/${conversation.id}`
                  class=conversation.unreadCount > 0 ? 'fw-bold' : ''
                )
                  .d-flex.align-items-center
                    .avatar.me-3
                      if conversation.otherParticipant.avatar
                        img.rounded-circle(src=conversation.otherParticipant.avatar, alt=conversation.otherParticipant.name, width="40", height="40")
                      else
                        .avatar-placeholder.rounded-circle.bg-secondary.text-white.d-flex.align-items-center.justify-content-center(style="width: 40px; height: 40px;")
                          i.fas.fa-user
                    .conversation-info
                      .participant-name= conversation.otherParticipant.name
                      small.text-muted.conversation-preview= conversation.lastMessagePreview
                  if conversation.unreadCount > 0
                    span.badge.bg-success.rounded-pill= conversation.unreadCount
            else
              .list-group-item.text-center.py-4
                i.fas.fa-inbox.text-muted.fa-2x.mb-3
                p.mb-0 No conversations yet
                small.text-muted Start sharing food to connect with others!
          
          .card-footer.bg-light.p-3
            button.btn.btn-success.w-100(type="button", data-bs-toggle="modal", data-bs-target="#newMessageModal")
              i.fas.fa-plus.me-2
              | New Message
        
        // Messaging Stats Card
        .card.shadow-sm.border-0
          .card-header.bg-light
            h5.mb-0 Your Messaging Stats
          .card-body
            .row.g-3
              .col-6
                .stat-item.text-center
                  .stat-value.text-success.fw-bold= stats.totalConversations
                  .stat-label.small Conversations
              .col-6
                .stat-item.text-center
                  .stat-value.text-success.fw-bold= stats.totalMessages
                  .stat-label.small Messages
              .col-6
                .stat-item.text-center
                  .stat-value.text-success.fw-bold= stats.responseRate + '%'
                  .stat-label.small Response Rate
              .col-6
                .stat-item.text-center
                  .stat-value.text-success.fw-bold= stats.averageResponseTime
                  .stat-label.small Avg. Response (min)
            
            .mt-3
              .progress.mb-2(style="height: 8px;")
                .progress-bar.bg-success(role="progressbar" style=`width: ${stats.responseRate}%` aria-valuenow=stats.responseRate aria-valuemin="0" aria-valuemax="100")
              .d-flex.justify-content-between
                small.text-muted Response Rate
                small.text-muted= stats.responseRate + '%'
      
      // Main content area
      .col-md-8.col-lg-9
        .card.shadow-sm.border-0.h-100
          .card-body.d-flex.flex-column.justify-content-center.align-items-center.py-5
            img.mb-4(src="/images/message-placeholder.svg", alt="Select a conversation", style="max-width: 200px; opacity: 0.6;")
            h4.text-center.mb-3 Select a conversation
            p.text-muted.text-center Choose a conversation from the list to view messages
            if conversations && conversations.length === 0
              .mt-4
                a.btn.btn-success(href="/listing")
                  i.fas.fa-search.me-2
                  | Browse Food Listings

  // New Message Modal
  #newMessageModal.modal.fade(tabindex="-1", aria-labelledby="newMessageModalLabel", aria-hidden="true")
    .modal-dialog
      .modal-content
        .modal-header.bg-success.text-white
          h5#newMessageModalLabel.modal-title
            i.fas.fa-paper-plane.me-2
            | New Message
          button.btn-close.btn-close-white(type="button", data-bs-dismiss="modal", aria-label="Close")
        .modal-body
          form#newMessageForm
            .mb-3
              label.form-label(for="recipient") Recipient
              select#recipient.form-select(required)
                option(value="", selected, disabled) Select a recipient
                each user in users
                  if user.id !== currentUser.id
                    option(value=user.id)= user.name
            
            .mb-3
              label.form-label(for="messageContent") Message
              textarea#messageContent.form-control(rows="4", required, placeholder="Type your message here...")
            
            .mb-3
              label.form-label Related Food Item (Optional)
              select#relatedItem.form-select
                option(value="", selected) None
                each listing in foodListings
                  option(value=listing.id)= listing.title
        
        .modal-footer
          button.btn.btn-secondary(type="button", data-bs-dismiss="modal") Cancel
          button.btn.btn-success(type="submit", form="newMessageForm")
            i.fas.fa-paper-plane.me-2
            | Send Message

block scripts
  script.
    // Initialize new message form
    document.getElementById('newMessageForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const recipientId = document.getElementById('recipient').value;
      const content = document.getElementById('messageContent').value;
      const relatedItemId = document.getElementById('relatedItem').value;
      
      if (!recipientId || !content) {
        alert('Please fill in all required fields');
        return;
      }
      
      try {
        // In a real implementation, you would send this to the server
        // For now, just close the modal and show a success message
        alert('Message sent successfully!');
        
        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('newMessageModal'));
        modal.hide();
        
        // Clear form
        this.reset();
        
        // Reload page to show new conversation
        window.location.reload();
      } catch (error) {
        console.error('Error sending message:', error);
        alert('Failed to send message. Please try again.');
      }
    });
