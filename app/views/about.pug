doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title About - Minimizing Food Waste
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css')
    link(rel='stylesheet', href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css')
    link(rel='stylesheet', href='/css/styles.css')
    style.
      .hero-section {
        background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('/images/food-waste-hero.jpg');
        background-size: cover;
        background-position: center;
        color: white;
        padding: 7rem 0;
      }
      .feature-card {
        transition: transform 0.3s;
        height: 100%;
      }
      .feature-card:hover {
        transform: translateY(-5px);
      }
      .icon-circle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: #e9f7ef;
        margin-bottom: 1.5rem;
      }
      .stats-section {
        background-color: #f8f9fa;
      }
      .stat-item {
        text-align: center;
      }
      .stat-number {
        font-size: 2.5rem;
        font-weight: bold;
        color: #28a745;
      }
      .step-item {
        position: relative;
        padding-left: 30px;
        margin-bottom: 2rem;
      }
      .step-number {
        position: absolute;
        left: 0;
        top: 0;
        width: 30px;
        height: 30px;
        background-color: #28a745;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
      }
      .testimonial-card {
        border-radius: 10px;
        overflow: hidden;
      }
      .testimonial-img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
      }

  body
    main
      // Hero Section
      section.hero-section.text-center
        .container
          h1.display-4.fw-bold.mb-4 About FoodShare
          p.lead.mb-5 We're on a mission to reduce food waste by connecting communities and saving valuable resources.
          a.btn.btn-success.btn-lg.px-4.me-md-2(href='/listings') Browse Available Food
          a.btn.btn-outline-light.btn-lg.px-4.ms-2(href='/tag-food') Share Your Food

      // Mission Section
      section.py-5
        .container
          .row.align-items-center
            .col-lg-6.mb-4.mb-lg-0
              img.img-fluid.rounded.shadow(src='/images/mission-image.jpg', alt='Our Mission')
            .col-lg-6
              h2.fw-bold.mb-4 Our Mission
              p.lead We partner with local communities to redistribute good-to-eat surplus food to those who need it most, reducing food waste and supporting sustainable living.
              p At FoodShare, we believe that good food should never go to waste. Our platform connects those with surplus food to those who can use it, creating a more sustainable and equitable food system for everyone.
              p.text-muted.mt-3 Established: December 7, 2023

      // Stats Section
      section.stats-section.py-5
        .container
          h2.text-center.mb-5 The Food Waste Problem
          .row.g-4
            .col-md-3.col-6
              .stat-item
                .stat-number 33%
                p.mb-0 of all food produced globally is wasted
            .col-md-3.col-6
              .stat-item
                .stat-number 1.3B
                p.mb-0 tonnes of food wasted annually
            .col-md-3.col-6
              .stat-item
                .stat-number 8%
                p.mb-0 of greenhouse gases from food waste
            .col-md-3.col-6
              .stat-item
                .stat-number £700
                p.mb-0 average annual cost per UK household

      // Features Section
      section.py-5.bg-white
        .container
          h2.text-center.mb-5 How We Help
          .row.g-4
            .col-md-4
              .card.feature-card.shadow-sm.h-100
                .card-body.text-center.p-4
                  .icon-circle
                    i.fas.fa-hands-helping.fa-2x.text-success
                  h3.card-title.h5 Community Connection
                  p.card-text We connect those with surplus food to those who need it, building stronger communities and reducing waste.
            .col-md-4
              .card.feature-card.shadow-sm.h-100
                .card-body.text-center.p-4
                  .icon-circle
                    i.fas.fa-leaf.fa-2x.text-success
                  h3.card-title.h5 Environmental Impact
                  p.card-text By diverting food from landfills, we reduce methane emissions and conserve the resources used to produce food.
            .col-md-4
              .card.feature-card.shadow-sm.h-100
                .card-body.text-center.p-4
                  .icon-circle
                    i.fas.fa-mobile-alt.fa-2x.text-success
                  h3.card-title.h5 Easy to Use
                  p.card-text Our platform makes it simple to list surplus food or find available items in your local area.

      // How It Works Section
      section.py-5.bg-light
        .container
          h2.text-center.mb-5 How It Works - Step-by-Step Guide
          .row
            .col-lg-6.mb-4.mb-lg-0
              img.img-fluid.rounded.shadow(src='/images/how-it-works.jpg', alt='How It Works')
            .col-lg-6
              .step-item
                .step-number 1
                h3 Create an Account
                p Sign up for free to join our community of food waste warriors.
              .step-item
                .step-number 2
                h3 Browse Available Listings
                p Find surplus food items near you that would otherwise go to waste.
              .step-item
                .step-number 3
                h3 Share Your Surplus
                p List any excess food items you have that others might be able to use.
              .step-item
                .step-number 4
                h3 Make the Connection
                p Arrange pickup or delivery with other community members.

      // Quote Section
      section.py-5.bg-success.text-white
        .container
          .row.justify-content-center
            .col-lg-8.text-center
              blockquote.blockquote
                p.mb-0.fs-4 "Every small effort to reduce waste helps us sustain our environment for future generations."
                footer.blockquote-footer.text-white.mt-3
                  cite FoodShare Initiative

      // Testimonials Section
      section.py-5
        .container
          h2.text-center.mb-5 What Our Community Says
          .row.g-4
            .col-md-6
              .card.testimonial-card.shadow-sm
                .card-body.p-4
                  .d-flex.align-items-center.mb-3
                    img.testimonial-img.me-3(src='/images/testimonial1.jpg', alt='Testimonial')
                    div
                      h5.mb-0 Alice Johnson
                      p.text-muted.mb-0 Community Member
                  p.card-text "I've saved so much money using FoodShare, and it feels great knowing I'm helping reduce waste in my community."
            .col-md-6
              .card.testimonial-card.shadow-sm
                .card-body.p-4
                  .d-flex.align-items-center.mb-3
                    img.testimonial-img.me-3(src='/images/testimonial2.jpg', alt='Testimonial')
                    div
                      h5.mb-0 Bob Smith
                      p.text-muted.mb-0 Local Restaurant Owner
                  p.card-text "As a restaurant owner, FoodShare has been invaluable in helping us find homes for our surplus food rather than throwing it away."

      // Join Section
      section.py-5.bg-light
        .container.text-center
          h2.mb-4 Join Our Community!
          p.lead.mb-4 Become part of a growing movement dedicated to minimizing food waste and creating a sustainable future.
          a.btn.btn-success.btn-lg(href='/signup') Sign Up Today

    footer.bg-dark.text-white.py-4
      .container
        .row
          .col-md-4.mb-4.mb-md-0
            h5 FoodShare
            p Reducing food waste, one connection at a time.
          .col-md-4.mb-4.mb-md-0
            h5 Quick Links
            ul.list-unstyled
              li
                a.text-white(href='/') Home
              li
                a.text-white(href='/about') About
              li
                a.text-white(href='/listings') Listings
              li
                a.text-white(href='/contact') Contact
          .col-md-4
            h5 Connect With Us
            ul.list-unstyled.d-flex.justify-content-start.justify-content-md-end
              li.me-3
                a.text-white(href='#')
                  i.fab.fa-facebook-f.fa-lg
              li.me-3
                a.text-white(href='#')
                  i.fab.fa-twitter.fa-lg
              li.me-3
                a.text-white(href='#')
                  i.fab.fa-instagram.fa-lg
        hr.my-4
        p.text-center.mb-0 &copy; 2025 FoodShare Initiative. All rights reserved.

    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js')
