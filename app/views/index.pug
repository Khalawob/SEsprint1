doctype html
html(lang="en")
  head
    title= title
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="description" content="Community-driven platform to reduce food waste and build sustainable communities")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    link(rel="stylesheet" href="/css/style.css")
  body
    // Navigation Bar
    nav.navbar.navbar-expand-lg.navbar-dark.bg-success.fixed-top
      .container
        a.navbar-brand(href='/')
          i.fas.fa-seedling.me-2
          | Minimise Food Waste
        button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNav')
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.ms-auto
            li.nav-item
              a.nav-link(href='/listing') Browse Food
            li.nav-item
              a.nav-link(href='/recommendations') 
                i.fas.fa-lightbulb.me-1
                | Recommendations
            li.nav-item
              a.nav-link(href='/messages')
                i.fas.fa-comments.me-1
                | Messages
                if user && user.unreadMessages > 0
                  span.badge.bg-danger.ms-1= user.unreadMessages
            li.nav-item
              a.nav-link(href='/userlist') Community
            li.nav-item
              a.nav-link(href='/about') About Us
            if user && user.isLoggedIn
              li.nav-item.dropdown
                a.nav-link.dropdown-toggle(href='#' id='userDropdown' role='button' data-bs-toggle='dropdown' aria-expanded='false')
                  i.fas.fa-user-circle.me-1
                  | My Profile
                  if user.points
                    span.badge.bg-light.text-success.ms-1= user.points
                ul.dropdown-menu.dropdown-menu-end(aria-labelledby='userDropdown')
                  li
                    a.dropdown-item(href='/userprofile')
                      i.fas.fa-user.me-2
                      | Profile
                  li
                    a.dropdown-item(href='/userprofile#badges')
                      i.fas.fa-award.me-2
                      | Badges
                  li
                    hr.dropdown-divider
                  li
                    a.dropdown-item(href='/logout')
                      i.fas.fa-sign-out-alt.me-2
                      | Logout
            else
              li.nav-item
                a.nav-link.btn.btn-outline-light.ms-2(href='/login') Login
              li.nav-item
                a.nav-link.btn.btn-light.text-success.ms-2(href='/signup') Sign Up

    // Hero Section
    .hero-section.bg-success.text-white.py-5
      .container.mt-5
        .row.align-items-center
          .col-lg-6.mb-5.mb-lg-0
            h1.display-4.fw-bold Reduce Food Waste, Build Community
            p.lead.mb-4 Join our platform to share excess food, connect with neighbors, and make a positive impact on the environment.
            if !user || !user.isLoggedIn
              .d-grid.gap-2.d-md-flex.justify-content-md-start
                a.btn.btn-light.btn-lg.px-4.me-md-2(href='/signup') Sign Up
                a.btn.btn-outline-light.btn-lg.px-4(href='/login') Login
            else
              .d-grid.gap-2.d-md-flex.justify-content-md-start
                a.btn.btn-light.btn-lg.px-4.me-md-2(href='/tag')
                  i.fas.fa-plus-circle.me-2
                  | Share Food
                a.btn.btn-outline-light.btn-lg.px-4(href='/recommendations')
                  i.fas.fa-lightbulb.me-2
                  | Get Recommendations
          .col-lg-6
            img.img-fluid.rounded.shadow(src='https://images.unsplash.com/photo-1542838132-92c53300491e?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80' alt='People sharing food')

    // Advanced Features Showcase
    if user && user.isLoggedIn
      .container.py-5
        h2.text-center.mb-4
          i.fas.fa-star.text-warning.me-2
          | Advanced Features
        .row.g-4
          // Matching Algorithm Card
          .col-md-6.col-lg-3
            .card.h-100.border-0.shadow-sm
              .card-header.bg-success.text-white.py-3.text-center
                h5.mb-0
                  i.fas.fa-puzzle-piece.me-2
                  | Smart Matching
              .card-body
                p.card-text Our advanced algorithm matches you with food items based on:
                ul.list-group.list-group-flush.mb-3
                  li.list-group-item
                    i.fas.fa-map-marker-alt.text-success.me-2
                    | Location proximity
                  li.list-group-item
                    i.fas.fa-calendar-alt.text-success.me-2
                    | Food freshness
                  li.list-group-item
                    i.fas.fa-utensils.text-success.me-2
                    | Dietary preferences
                  li.list-group-item
                    i.fas.fa-history.text-success.me-2
                    | Past interactions
              .card-footer.bg-white.text-center
                a.btn.btn-outline-success(href='/recommendations')
                  i.fas.fa-lightbulb.me-2
                  | View Recommendations

          // Points System Card
          .col-md-6.col-lg-3
            .card.h-100.border-0.shadow-sm
              .card-header.bg-primary.text-white.py-3.text-center
                h5.mb-0
                  i.fas.fa-star.me-2
                  | Points & Rewards
              .card-body
                if user.points
                  .text-center.mb-3
                    .display-6.fw-bold.text-primary= user.points
                    p.text-muted Total Points
                  if user.level
                    .progress.mb-2(style='height: 8px;')
                      .progress-bar.bg-primary(role='progressbar' style=`width: ${user.level.progressPercentage}%` aria-valuenow=user.level.progressPercentage aria-valuemin='0' aria-valuemax='100')
                    .d-flex.justify-content-between.small.text-muted.mb-3
                      span #{user.level.name} Level
                      if user.level.nextLevel
                        span #{user.level.pointsToNextLevel} to next level
                  .badges-preview.d-flex.justify-content-center.mb-3
                    if user.badges && user.badges.length > 0
                      each badge, index in user.badges.slice(0, 3)
                        .badge-icon.bg-light.p-2.rounded-circle.mx-1(data-bs-toggle='tooltip' title=badge.name)
                          i(class=`fas fa-${badge.icon || 'award'} text-${badge.color || 'primary'}`)
                    else
                      .badge-icon.bg-light.p-2.rounded-circle.mx-1(data-bs-toggle='tooltip' title='Early Adopter')
                        i.fas.fa-seedling.text-success
                      .badge-icon.bg-light.p-2.rounded-circle.mx-1(data-bs-toggle='tooltip' title='Food Saver')
                        i.fas.fa-apple-alt.text-danger
                else
                  p.card-text Earn points by sharing food, completing exchanges, and being active in the community.
                  ul.list-group.list-group-flush.mb-3
                    li.list-group-item
                      i.fas.fa-share-alt.text-primary.me-2
                      | 50 points for sharing food
                    li.list-group-item
                      i.fas.fa-shopping-basket.text-primary.me-2
                      | 20 points for collecting food
                    li.list-group-item
                      i.fas.fa-star.text-primary.me-2
                      | Earn badges and level up
              .card-footer.bg-white.text-center
                a.btn.btn-outline-primary(href='/userprofile#badges')
                  i.fas.fa-award.me-2
                  | View All Badges

          // Messaging Card
          .col-md-6.col-lg-3
            .card.h-100.border-0.shadow-sm
              .card-header.bg-info.text-white.py-3.text-center
                h5.mb-0
                  i.fas.fa-comments.me-2
                  | In-App Messaging
              .card-body
                if user.conversations && user.conversations.length > 0
                  p.card-text.mb-3 Recent conversations:
                  .list-group.small.mb-3
                    each conversation, index in user.conversations.slice(0, 3)
                      a.list-group-item.list-group-item-action.d-flex.justify-content-between.align-items-center(href=`/messages/${conversation.id}`)
                        .d-flex.align-items-center
                          .avatar-sm.me-2
                            if conversation.otherParticipant && conversation.otherParticipant.avatar
                              img.rounded-circle(src=conversation.otherParticipant.avatar, alt='', width='30', height='30')
                            else
                              .avatar-placeholder.rounded-circle.bg-secondary.text-white.d-flex.align-items-center.justify-content-center(style='width: 30px; height: 30px;')
                                i.fas.fa-user.fa-sm
                          div
                            .fw-bold= conversation.otherParticipant ? conversation.otherParticipant.name : 'User'
                            small.text-truncate.d-block(style='max-width: 150px;')= conversation.lastMessagePreview
                        if conversation.unreadCount > 0
                          span.badge.bg-info.rounded-pill= conversation.unreadCount
                else
                  p.card-text Connect with other users to arrange food pickups and deliveries.
                  ul.list-group.list-group-flush.mb-3
                    li.list-group-item
                      i.fas.fa-paper-plane.text-info.me-2
                      | Real-time messaging
                    li.list-group-item
                      i.fas.fa-bell.text-info.me-2
                      | Message notifications
                    li.list-group-item
                      i.fas.fa-handshake.text-info.me-2
                      | Arrange exchanges easily
              .card-footer.bg-white.text-center
                a.btn.btn-outline-info(href='/messages')
                  i.fas.fa-comments.me-2
                  | Open Messages

          // Location Services Card
          .col-md-6.col-lg-3
            .card.h-100.border-0.shadow-sm
              .card-header.bg-warning.text-dark.py-3.text-center
                h5.mb-0
                  i.fas.fa-map-marked-alt.me-2
                  | Location Services
              .card-body
                if weather
                  .current-weather.mb-3.text-center
                    i(class=`fas fa-${weather.icon} fa-3x text-warning mb-2`)
                    h5.mb-0 #{weather.temperature}
                    p.text-muted #{weather.condition}
                  h6.mb-2 Optimal pickup times:
                  .list-group.small.mb-3
                    each slot in suggestedTimeSlots || [{label: 'Afternoon (12pm - 5pm)', score: 5}]
                      .list-group-item.d-flex.justify-content-between.align-items-center
                        span= slot.label
                        .rating
                          - var n = 0
                          while n < slot.score
                            i.fas.fa-star.text-warning.small
                            - n++
                else
                  p.card-text Our location services help you find food nearby and plan optimal pickups.
                  ul.list-group.list-group-flush.mb-3
                    li.list-group-item
                      i.fas.fa-map-marker-alt.text-warning.me-2
                      | Find food nearby
                    li.list-group-item
                      i.fas.fa-route.text-warning.me-2
                      | Get directions
                    li.list-group-item
                      i.fas.fa-cloud-sun.text-warning.me-2
                      | Weather-based pickup times
              .card-footer.bg-white.text-center
                a.btn.btn-outline-warning(href='/recommendations#nearby')
                  i.fas.fa-map-marker-alt.me-2
                  | Find Nearby Food

    // Advanced Search Section
    .container.py-4
      .card.border-0.shadow-sm.mb-5
        .card-body
          h3.text-center.mb-4 Find Food Near You
          form#searchForm.row.g-3
            .col-md-3
              label.form-label(for="foodType") Food Type
              select#foodType.form-select(aria-label="Food type selection")
                option(selected) All Types
                option Vegetables
                option Fruits
                option Baked Goods
                option Dairy
                option Prepared Meals
            .col-md-3
              label.form-label(for="distance") Distance
              select#distance.form-select(aria-label="Distance selection")
                option(selected) Any Distance
                option Within 1 mile
                option Within 3 miles
                option Within 5 miles
            .col-md-3
              label.form-label(for="availability") Availability
              select#availability.form-select(aria-label="Availability selection")
                option(selected) Available Now
                option Today
                option This Week
            .col-md-3
              label.form-label(for="dietary") Dietary Preferences
              select#dietary.form-select(aria-label="Dietary preferences")
                option(selected) All Types
                option Vegetarian
                option Vegan
                option Gluten-Free
                option Organic
            .col-12.text-center.mt-3
              button.btn.btn-success.px-4(type="submit")
                i.fas.fa-search.me-2
                | Search Food

    // Featured Food Listings
    .container.py-5
      h2.text-center.mb-5 Featured Food Listings
      .row.g-4
        .col-md-4
          .card.h-100.border-0.shadow-sm
            img.card-img-top(src='https://images.unsplash.com/photo-1576021182211-9ea8dced3690?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=60' alt='Fresh Vegetables')
            .card-body
              h5.card-title Fresh Garden Vegetables
              p.card-text Assorted vegetables from my garden - tomatoes, cucumbers, and more.
              .d-flex.justify-content-between.align-items-center.mt-3
                .user-info.d-flex.align-items-center
                  img.rounded-circle.me-2(src='https://randomuser.me/api/portraits/women/12.jpg' width='30' height='30')
                  span Sarah J.
                .d-flex.align-items-center
                  small.text-muted
                    i.fas.fa-map-marker-alt.me-1
                    | 0.8 miles away
                  a.btn.btn-sm.btn-outline-success.ms-2(href='/listing') View Details
        .col-md-4
          .card.h-100.border-0.shadow-sm
            img.card-img-top(src='https://images.unsplash.com/photo-1563699182-58875fcdd4e3?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=60' alt='Fresh Fruits')
            .card-body
              h5.card-title Organic Apples
              p.card-text 5 apples available, picked yesterday. Must go today!
              .d-flex.justify-content-between.align-items-center.mt-3
                .user-info.d-flex.align-items-center
                  img.rounded-circle.me-2(src='https://randomuser.me/api/portraits/men/32.jpg' width='30' height='30')
                  span John D.
                .d-flex.align-items-center
                  small.text-muted
                    i.fas.fa-map-marker-alt.me-1
                    | 1.5 miles away
                  a.btn.btn-sm.btn-outline-success.ms-2(href='/listing') View Details
        .col-md-4
          .card.h-100.border-0.shadow-sm
            img.card-img-top(src='https://images.unsplash.com/photo-1509440159596-0249088772ff?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=60' alt='Homemade Bread')
            .card-body
              h5.card-title Homemade Sourdough Bread
              p.card-text 2 loaves of sourdough bread, baked this morning.
              .d-flex.justify-content-between.align-items-center.mt-3
                .user-info.d-flex.align-items-center
                  img.rounded-circle.me-2(src='https://randomuser.me/api/portraits/women/68.jpg' width='30' height='30')
                  span Maria P.
                .d-flex.align-items-center
                  small.text-muted
                    i.fas.fa-map-marker-alt.me-1
                    | 2.3 miles away
                  a.btn.btn-sm.btn-outline-success.ms-2(href='/listing') View Details

    // Real-time Activity Feed
    .container.py-5
      h2.text-center.mb-4 Community Activity
      .row
        .col-md-8.mx-auto
          #activityFeed.list-group.shadow-sm
            .list-group-item.border-0
              .d-flex.align-items-center
                img.rounded-circle.me-3(src='https://randomuser.me/api/portraits/women/12.jpg' width='40' height='40')
                .activity-content
                  strong Sarah J.
                  |  shared 5 kg of fresh vegetables
                  small.d-block.text-muted Just now
              span.badge.bg-success.rounded-pill New
            .list-group-item.border-0
              .d-flex.align-items-center
                img.rounded-circle.me-3(src='https://randomuser.me/api/portraits/men/32.jpg' width='40' height='40')
                .activity-content
                  strong John D.
                  |  earned the "Super Sharer" badge
                  small.d-block.text-muted 5 minutes ago
              span.badge.bg-primary.rounded-pill Badge
            .list-group-item.border-0
              .d-flex.align-items-center
                img.rounded-circle.me-3(src='https://randomuser.me/api/portraits/men/45.jpg' width='40' height='40')
                .activity-content
                  strong Alex T.
                  |  collected bread from
                  strong  Maria P.
                  small.d-block.text-muted 15 minutes ago
              span.badge.bg-info.rounded-pill Completed

    // Environmental Impact Calculator
    .bg-light.py-5
      .container
        h2.text-center.mb-4 Your Environmental Impact
        .row.justify-content-center
          .col-md-8
            .card.border-0.shadow
              .card-body
                #impactCalculator.text-center
                  h4.mb-4 Calculate Your Impact
                  .row.g-3
                    .col-md-6
                      .form-floating
                        input#foodWeight.form-control(type="number" placeholder="0")
                        label(for="foodWeight") Food Shared (kg)
                    .col-md-6
                      .form-floating
                        input#milesSaved.form-control(type="number" placeholder="0")
                        label(for="milesSaved") Transport Distance Saved (miles)
                  .mt-4
                    button#calculateImpact.btn.btn-success.px-4
                      i.fas.fa-calculator.me-2
                      | Calculate Impact
                  #impactResults.mt-4.d-none
                    .row.text-center
                      .col-md-4
                        i.fas.fa-leaf.fa-2x.text-success.mb-2
                        h5 CO2 Saved
                        p#co2Saved.lead.text-success 0 kg
                      .col-md-4
                        i.fas.fa-tint.fa-2x.text-info.mb-2
                        h5 Water Saved
                        p#waterSaved.lead.text-info 0 L
                      .col-md-4
                        i.fas.fa-bolt.fa-2x.text-warning.mb-2
                        h5 Energy Saved
                        p#energySaved.lead.text-warning 0 kWh

    // Impact Statistics
    .bg-light.py-5
      .container
        h2.text-center.mb-5 Our Impact
        .row.text-center
          .col-md-3.mb-4.mb-md-0
            .display-4.fw-bold.text-success 500+
            p.text-muted Active Members
          .col-md-3.mb-4.mb-md-0
            .display-4.fw-bold.text-success 1,200
            p.text-muted Food Items Shared
          .col-md-3.mb-4.mb-md-0
            .display-4.fw-bold.text-success 85%
            p.text-muted Successful Exchanges
          .col-md-3
            .display-4.fw-bold.text-success 2.5t
            p.text-muted Food Waste Prevented

    // Call to Action
    .bg-success.text-white.py-5
      .container.text-center
        h2.mb-4 Ready to Reduce Food Waste?
        p.lead.mb-4 Join our community today and be part of the solution.
        if !user || !user.isLoggedIn
          .d-grid.gap-2.d-md-flex.justify-content-md-center
            a.btn.btn-light.btn-lg.px-4.me-md-2(href='/signup') Sign Up Now
            a.btn.btn-outline-light.btn-lg.px-4(href='/login') Login
        else
          .d-grid.gap-2.d-md-flex.justify-content-md-center
            a.btn.btn-light.btn-lg.px-4.me-md-2(href='/listing') Browse Food
            a.btn.btn-outline-light.btn-lg.px-4(href='/userprofile') My Profile

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")
    script(src="https://code.jquery.com/jquery-3.6.0.min.js")
    script.
      // Initialize tooltips
      var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
      var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl)
      })

      // Environmental Impact Calculator
      document.getElementById('calculateImpact').addEventListener('click', function() {
        const foodWeight = parseFloat(document.getElementById('foodWeight').value) || 0;
        const milesSaved = parseFloat(document.getElementById('milesSaved').value) || 0;
        
        // Calculate environmental impact
        const co2Saved = (foodWeight * 2.5 + milesSaved * 0.4).toFixed(2);
        const waterSaved = (foodWeight * 1000).toFixed(0);
        const energySaved = (foodWeight * 4.5).toFixed(2);
        
        // Update results
        document.getElementById('co2Saved').textContent = `${co2Saved} kg`;
        document.getElementById('waterSaved').textContent = `${waterSaved} L`;
        document.getElementById('energySaved').textContent = `${energySaved} kWh`;
        
        document.getElementById('impactResults').classList.remove('d-none');
      });

      // Search form handling
      document.getElementById('searchForm').addEventListener('submit', function(e) {
        e.preventDefault();
        
        const foodType = document.getElementById('foodType').value;
        const distance = document.getElementById('distance').value;
        const availability = document.getElementById('availability').value;
        const dietary = document.getElementById('dietary').value;
        
        // Redirect to listings page with search parameters
        window.location.href = `/listing?foodType=${encodeURIComponent(foodType)}&distance=${encodeURIComponent(distance)}&availability=${encodeURIComponent(availability)}&dietary=${encodeURIComponent(dietary)}`;
      });
